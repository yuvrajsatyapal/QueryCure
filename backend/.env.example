# Copy to backend/.env for local development. Never commit the real .env.
QC_PROFILE=local
LOG_LEVEL=INFO

# Metadata DB (infra/docker/compose.yaml). The app connects as the restricted qc_app role;
# migrations use the owner role. Passwords below are the compose dev-only defaults.
DATABASE_URL=postgresql://qc_app:qc_local_dev_only@127.0.0.1:5432/querycure
DATABASE_URL_DIRECT=postgresql://qc_app:qc_local_dev_only@127.0.0.1:5432/querycure
DATABASE_MIGRATION_URL=postgresql://qc_owner:qc_local_dev_only@127.0.0.1:5432/querycure

# 32 random bytes, base64. Generate: python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
QC_MASTER_KEY=
QC_MASTER_KEY_VERSION=1

# Local profile only; the demo profile refuses true.
ALLOW_PRIVATE_TARGETS=true
CORS_ORIGINS=["http://localhost:3000"]

# LLM (ADR-0016): free OpenRouter models only. Paid models are refused at startup and a
# response with non-zero cost stops the run. Put your key in OPENROUTER_API_KEY.
OPENROUTER_API_KEY=
LLM_PROVIDER=openrouter
# openrouter/free routes per request; pin a specific ':free' model for reproducible runs.
LLM_MODEL=openrouter/free
LLM_FREE_ONLY=true
LLM_REQUESTS_PER_MINUTE=16
LLM_DAILY_REQUEST_LIMIT=45
LLM_MAX_CONCURRENCY=1
# Only used if LLM_FREE_ONLY=false (paid, opt-in):
GEMINI_API_KEY=
