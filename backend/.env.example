# Copy to backend/.env for local development. Never commit the real .env.
QC_PROFILE=local
LOG_LEVEL=INFO

# Metadata DB (infra/docker/compose.yaml). The app connects as the restricted qc_app role;
# migrations use the owner role. Passwords below are the compose dev-only defaults.
DATABASE_URL=postgresql://qc_app:qc_local_dev_only@127.0.0.1:5432/querycure
DATABASE_URL_DIRECT=postgresql://qc_app:qc_local_dev_only@127.0.0.1:5432/querycure
DATABASE_MIGRATION_URL=postgresql://qc_owner:qc_local_dev_only@127.0.0.1:5432/querycure

# --- Neon (hosted Postgres) -------------------------------------------------------------
# To use Neon instead of local Docker: comment out the three DATABASE_* lines above and
# uncomment these. Copy the host from Neon > Connection Details (toggle "Connection pooling").
# Keep ?sslmode=require. One-time setup in the Neon SQL editor, before the first migration:
#   CREATE ROLE qc_app WITH LOGIN PASSWORD '<strong password>' NOSUPERUSER NOCREATEDB NOCREATEROLE;
#   CREATE ROLE qc_retention WITH LOGIN PASSWORD '<strong password>' NOSUPERUSER NOCREATEDB NOCREATEROLE;
# Then run migrations (owner URL), and the app connects as qc_app.
# Pooled host (contains "-pooler"): normal request traffic, restricted role. Timeouts are applied
# per transaction here (ADR-0025); a pooled DATABASE_URL requires DATABASE_URL_DIRECT below.
# DATABASE_URL=postgresql://qc_app:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require
# Direct host (no "-pooler"): LISTEN/NOTIFY (live progress) and the agent checkpointer, restricted role.
# DATABASE_URL_DIRECT=postgresql://qc_app:<password>@<endpoint>.<region>.aws.neon.tech/<dbname>?sslmode=require
# Direct host, Neon's default owner role: migrations only.
# DATABASE_MIGRATION_URL=postgresql://<owner role>:<password>@<endpoint>.<region>.aws.neon.tech/<dbname>?sslmode=require
# Daily retention job only (python -m querycure.ops retention):
# DATABASE_RETENTION_URL=postgresql://qc_retention:<password>@<endpoint>.<region>.aws.neon.tech/<dbname>?sslmode=require

# 32 random bytes, base64. Generate: python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
QC_MASTER_KEY=
QC_MASTER_KEY_VERSION=1

# Local profile only; the demo profile refuses true.
ALLOW_PRIVATE_TARGETS=true
CORS_ORIGINS=["http://localhost:3000"]

# LLM (ADR-0016): free OpenRouter models only. Paid models are refused at startup and a
# response with non-zero cost stops the run. Put your key in OPENROUTER_API_KEY.
OPENROUTER_API_KEY=
LLM_PROVIDER=openrouter
# Pinned, tested structured-output model (ADR-0026). Do not use the openrouter/free router as
# the primary: it picks a different free model per request and, in the 2026-10-17 audit,
# returned valid structured output for 1 of 10 calls. Check any other model first with
# `uv run python -m querycure.llm.probe --model <id>` (one request).
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Optional, bounded fallback (free models only): tried once per call when the primary is
# unavailable or still returns invalid JSON after repair; skipped after repeated failures
# (LLM_CIRCUIT_THRESHOLD). Never used for quota exhaustion. Empty = no fallback, which saves
# the daily free allowance. Example: LLM_FALLBACK_MODEL=openrouter/free
LLM_FALLBACK_MODEL=
LLM_CIRCUIT_THRESHOLD=2
LLM_FREE_ONLY=true
LLM_REQUESTS_PER_MINUTE=16
LLM_DAILY_REQUEST_LIMIT=45
LLM_MAX_CONCURRENCY=1
# Only used if LLM_FREE_ONLY=false (paid, opt-in):
GEMINI_API_KEY=
# Groq (ADR-0027), local profile only. To use it: set GROQ_API_KEY, LLM_PROVIDER=groq and a Groq
# model id, e.g. LLM_MODEL=llama-3.3-70b-versatile (check it first with the probe above).
# Groq reports no cost, so LLM_FREE_ONLY trusts the key to be on Groq's free plan (no card on
# file): a key on a paid plan would be billed. LLM_REQUESTS_PER_MINUTE applies; the daily count
# does not (Groq's own per-day limit stops the run instead).
GROQ_API_KEY=

# Mode C sandbox (infra/docker/compose.yaml: sandbox-db via sandbox-relay on 127.0.0.1:55432).
# The admin role only creates/drops databases and builds templates; candidate SQL runs as the
# non-superuser qc_bench role, whose password the worker sets on startup. Dev-only defaults.
SANDBOX_ADMIN_URL=postgresql://qc_sandbox_admin:qc_local_dev_only@127.0.0.1:55432/sandbox_admin
SANDBOX_BENCH_PASSWORD=qc_local_dev_only

# GitHub OAuth sign-in (optional; offered only when BOTH id and secret are set).
# Uncomment and fill in together - a lone ID or secret fails startup.
# Callback URL: <PUBLIC_API_URL>/api/v1/auth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Required (https://) outside the local profile when any OAuth sign-in is on.
# PUBLIC_API_URL=
# WEB_BASE_URL=

# Google sign-in (optional; offered only when BOTH id and secret are set - a lone one fails
# startup). Create an OAuth client (type "Web application") in Google Cloud Console >
# APIs & Services > Credentials, with the authorized redirect URI
# <PUBLIC_API_URL>/api/v1/auth/google/callback  (local: http://localhost:8000/api/v1/auth/google/callback,
# which also needs PUBLIC_API_URL=http://localhost:8000 and WEB_BASE_URL=http://localhost:3000).
# QueryCure requests only the "openid profile" scopes; no email address is read or stored.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Bearer token for the /metrics endpoint (open locally; 404 elsewhere without it).
# METRICS_TOKEN=
