# Copy to backend/.env for local development. Never commit the real .env.
QD_PROFILE=local
LOG_LEVEL=INFO

# Metadata DB (infra/docker/compose.yaml). The app connects as the restricted qd_app role (from T1.4).
DATABASE_URL=postgresql://qd_app:change-me@127.0.0.1:5432/querydoctor
DATABASE_URL_DIRECT=postgresql://qd_app:change-me@127.0.0.1:5432/querydoctor

# 32 random bytes, base64. Generate: python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
QD_MASTER_KEY=
QD_MASTER_KEY_VERSION=1

# Local profile only; the demo profile refuses true.
ALLOW_PRIVATE_TARGETS=true
CORS_ORIGINS=["http://localhost:3000"]

# Local-profile fallback LLM keys (ignored in demo; BYOK there). Leave empty unless needed.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
