        "title": "SessionResponse",
        "type": "object"
      },
      "UserKind": {
        "enum": [
          "local",
          "anonymous",
          "oauth"
        ],
        "title": "UserKind",
        "type": "string"
      },
      "UserOut": {
        "properties": {
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/UserKind"
          }
        },
        "required": [
          "id",
          "kind",
          "display_name"
        ],
        "title": "UserOut",
        "type": "object"
      }
    }
